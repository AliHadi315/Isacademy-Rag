# ---------------------------------------------------------------------------
# Isacademy Capstone - configuration.  Copy to .env.  NEVER commit .env
# ---------------------------------------------------------------------------

# --- Gemini (the only AI provider: text + vision) --------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings (local model, not an LLM provider) -------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# seconds to wait for the first model load before using the offline fallback
EMBEDDING_LOAD_TIMEOUT=300

# --- Storage ---------------------------------------------------------------
CHROMA_PATH=./data/vector_db
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/reports

# --- Retrieval -------------------------------------------------------------
TOP_K=5
SIMILARITY_THRESHOLD=0.30
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Semantic PCA ----------------------------------------------------------
PCA_NEIGHBORS=25
PCA_MAX_POINTS=100
PCA_CLUSTERS=3

# --- UI --------------------------------------------------------------------
# en | ar
DEFAULT_LANGUAGE=en

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=50
ENABLE_OCR=false
LOG_LEVEL=INFO
